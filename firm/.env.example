# Copy to .env (gitignored) and adjust. Dev-only credentials; never reuse in production.
# Compose reads ./.env automatically to fill ${...} placeholders in compose.yaml.
POSTGRES_USER=firm
POSTGRES_PASSWORD=firm_dev
POSTGRES_DB=firm
DB_PORT=5433

# Owner role: migrations only (drizzle-kit). Bypasses RLS because it is a superuser.
DATABASE_URL=postgres://firm:firm_dev@127.0.0.1:5433/firm

# App role (firm_app): what the running app and tests use. Subject to RLS.
# Password is set out of band, see SETUP.md.
APP_DATABASE_URL=postgres://firm_app:firm_app_dev@127.0.0.1:5433/firm
