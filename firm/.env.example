# Copy to .env (gitignored) and adjust. Dev-only credentials; never reuse in production.
# Compose reads ./.env automatically to fill ${...} placeholders in compose.yaml.
POSTGRES_USER=firm
POSTGRES_PASSWORD=firm_dev
POSTGRES_DB=firm
DB_PORT=5433

# Used by the app (Drizzle) later; must match the values above.
DATABASE_URL=postgres://firm:firm_dev@127.0.0.1:5433/firm
